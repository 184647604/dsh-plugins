{
  "name": "dsh-mcp-admin",
  "version": "0.2.1",
  "description": "dsh web 的 MCP 服务器管理插件:增删改查、启停、重启,loader 热生效。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
