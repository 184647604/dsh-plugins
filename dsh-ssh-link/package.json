{
  "name": "dsh-ssh-link",
  "version": "0.1.0",
  "description": "dsh 的 SSH 桥:把远端机器当本机用 —— ssh_exec 跑任意命令,并把远端 dsh headless 注册成 subagent 后端。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ssh",
    "remote",
    "subagent",
    "plugin",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "title": "SSH 桥"
  }
}
